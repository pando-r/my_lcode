# Lcode 配置文件示例
# 复制为 .lcode/config.yaml 并填入真实密钥后运行 `lcode`。
# 注意：.lcode/config.yaml 已被 .gitignore 忽略，请勿提交真实密钥。

providers:
  - name: Claude                # 状态栏左侧显示的名称
    protocol: anthropic         # 协议类型：anthropic / openai
    api_key: sk-ant-xxxx        # 替换为你的 Anthropic API key
    model: claude-sonnet-5-5    # 状态栏右侧显示的模型名
    base_url: null              # 可选：自定义端点（兼容服务），null 使用官方默认
    thinking: true              # 可选：开启扩展思考（仅 anthropic 生效）

  # 第二个 provider 示例（OpenAI 协议）。取消注释即可启用，启动后会先出现选择列表。
  # - name: GPT
  #   protocol: openai
  #   api_key: sk-xxxx          # 替换为你的 OpenAI API key
  #   model: gpt-4o
  #   base_url: null            # 可选：自定义端点


# ── 项目记忆与会话存档（无需在此配置，按目录约定自动工作）──────────────────
# 项目指令 LCODE.md（三层优先级，高在前）：
#   <project>/LCODE.md
#   <project>/.lcode/LCODE.md
#   ~/.lcode/LCODE.md
# 指令文件支持独占一行的 `@include <relative_path>`，最多嵌套 5 层。
#
# 长期记忆（自动维护，索引 MEMORY.md 会注入系统提示）：
#   <project>/.lcode/memory/     （项目级：project_knowledge / reference_material）
#   ~/.lcode/memory/             （用户级：user_preference / correction_feedback）
#
# 会话存档（JSONL 追加写，进程崩溃最多丢最后一行；30 天前自动清理）：
#   <project>/.lcode/sessions/<YYYYMMDD-HHMMSS-xxxx>/conversation.jsonl
# 在 TUI 中输入 /resume 可从历史会话列表恢复。
