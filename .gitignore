# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
dist/
build/
.mypy_cache/
.ruff_cache/

# Claude Code local settings
.claude/settings.local.json

# Lcode runtime config (contains real API keys)
.lcode/config.yaml

# Lcode local permission rules (human-in-the-loop "always allow" writes here)
.lcode/settings.local.yaml

# Lcode session archives (JSONL + tool-result spill files)
.lcode/sessions/

# ch14: Worktree 隔离副本（仅供 SubAgent 与手动管理使用）
.lcode/worktrees/
.lcode/worktree_session.json

# 常驻模式运行态：队列 / 结果 / 日志 / 单实例锁（本地状态，不入库）
.lcode/resident/

# 通知通道配置（webhook URL 可能带 token / SMTP 授权码）与通知流水
.lcode/notify.yaml
.lcode/notifications.jsonl

# 主动发信流水：含收件人地址和正文预览，属于通信内容，不入库
.lcode/mail-outbox.jsonl

# 旧版目录名残留（重命名前的运行态，建议手工删除）
.mewcode/

# 语音数据（vosk 模型 42MB / 日志 / 指令记录）实际在 ~/.lcode/voice/，
# 不在仓库里。这里只挡一种情况：有人把 --voice-model-dir 指到项目内。
.lcode/voice/
