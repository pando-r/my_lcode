# Lcode 通知通道配置模板
#
# 复制到 <项目根>/.lcode/notify.yaml 后按需修改。
# 常驻任务跑完 / 失败会自动发一条通知；Agent 也可以主动用 notify 工具发。
#
# 优先级：环境变量 > 本文件 > 内置默认值
#   LCODE_NOTIFY_DESKTOP=0|1
#   LCODE_NOTIFY_WEBHOOK=<url>
#   LCODE_NOTIFY_MIN_LEVEL=info|ok|warn|error
#   LCODE_NOTIFY_EMAIL_AUTH=<授权码>   # 设了会自动启用 email 段

# 桌面横幅：Windows Toast / macOS 通知中心 / Linux notify-send
desktop: true

# 把通知 POST 成一个 JSON 到指定 URL（人不在电脑前时用，比如推到手机）
# JSON 结构：{"title","message","level","source","at"}
webhook: ""

# 低于这个级别的通知直接丢弃（info < ok < warn < error）
# 只想被失败打扰就写 error
min_level: info

# webhook 请求超时（秒）
webhook_timeout: 5

# 邮件通知：QQ 邮箱 / 163 / Gmail 都能用，个人 QQ、微信没有官方发消息 API。
# QQ 邮箱获取授权码：设置 → 账户 → 开启「POP3/SMTP 服务」→ 生成授权码。
# 授权码不是 QQ 密码；建议改用环境变量 LCODE_NOTIFY_EMAIL_AUTH，别写进文件。
email:
  enabled: false
  smtp_host: smtp.qq.com
  smtp_port: 465            # 465 = SSL；587 = STARTTLS（Gmail 用 587）
  user: ""                  # 发件人，如 123456@qq.com
  auth_code: ""             # 授权码，不是登录密码
  to: ""                    # 收件人，可以就是自己
  timeout: 10
