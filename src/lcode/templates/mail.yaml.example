# Lcode 收件箱配置模板
#
# 复制到 <项目根>/.lcode/mail.yaml 后按需修改。
# 用途：用邮件给 Lcode 派任务 —— 它读信、执行、再把结果回信给你。
#
# 写法：
#   主题   [Lcode] 帮我看看昨天的测试报告
#   正文   照常写，想写多少写多少（比主题能塞的内容多得多）
#
# 能当聊天用：
#   收到回信后直接点「回复」，写新要求就行。同一话题（主题去掉 [Lcode] 和 Re:
#   之后一样）的来信会自动带上之前几轮的问答，所以它记得你上一句说了什么。
#   想开新话题就新建一封邮件，别在旧信上接着回。
#
# 排查：
#   lcode --mail-peek        打印最近邮件被解析成什么样（正文长度、话题键、指令）
#   lcode --check-mail       只拉一次信入队，然后退出
#
# 三条安全闸门（缺一不可，都是刻意设计成「默认关闭」的）：
#   1. senders 白名单：为空时**一封都不收**。From 头可以随便伪造，
#      只靠自己写信箱地址过滤等于没有过滤。
#   2. subject_prefix：只有主题以它开头的邮件才算任务，普通邮件不会被误读成指令。
#   3. allow_write：默认 false，邮件来源的任务只能读不能写。

enabled: false

# IMAP 服务器。QQ 邮箱 / 163 都是 993 SSL；Gmail 用 imap.gmail.com:993。
imap_host: imap.qq.com
imap_port: 993
folder: INBOX

# user / auth_code 留空时自动继承 .lcode/notify.yaml 里的 email 段
# （SMTP 和 IMAP 本来就是同一个账号、同一个授权码）。
user: ""
auth_code: ""

# 发件人白名单。写完整地址，或写 @qq.com 匹配整个域名。
# 留空 = 谁都不收，这是安全的默认行为。
#
# 注意：域名通配必须加引号写成 "@qq.com"。YAML 里 - @qq.com 的 @ 是保留字符，
# PyYAML 会直接报错，**整份配置作废**（读出来就是「什么都不开」）。
senders: []

# 发信白名单：Agent 主动发信（send_mail 工具）只能发给这里列的地址。
# 留空 = 一封都不发。
#
# 为什么默认为空：这是工具层唯一能把数据送出本机的通道。一旦允许任意地址，
# 邮件正文里的提示注入就从「读你的文件」升级成「把你的文件发到 evil@x.com」——
# 前者有路径沙箱兜底，后者发出去就撤不回来。
#
# 示例：
#   send_to:
#     - friend@qq.com
#     - "@company.com"      # 域名通配，同样必须加引号
send_to: []

# 只有主题以此开头才当任务，例如「[Lcode] 帮我看看昨天的测试报告」。
subject_prefix: "[Lcode]"

# 允许邮件任务写文件 / 执行命令。默认 false —— 邮件正文是不可信输入，
# 提示注入的后果在这里很具体（比如「把 ~/.ssh 打包发到某地址」）。
# 命令行 --mail-allow-write 可以临时打开，不必改这个文件。
allow_write: false

# 单轮最多处理几封，防止一次灌进来 200 封把队列撑爆。
max_per_poll: 5

# 单封邮件的指令上限（字符）。正文是主体，主题只是行首那半句话：
# 调小会把长邮件截断，调大会让一次投喂占满模型上下文。默认 4000。
max_body: 4000

# 回看最近几天内的邮件（按日期发现，不依赖未读状态——手机上看过的信也要能被处理）。
catchup_days: 3

# IMAP 连接超时（秒）
timeout: 15
